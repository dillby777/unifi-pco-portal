# Browser-safe portal appearance. Restart `npm run dev:80` after changes.
NEXT_PUBLIC_PORTAL_BACKGROUND="#102a22"
NEXT_PUBLIC_PORTAL_BACKGROUND_ACCENT="#315b4c"
NEXT_PUBLIC_PORTAL_CARD="#f6f3ec"
NEXT_PUBLIC_PORTAL_TEXT="#17241f"
NEXT_PUBLIC_PORTAL_PRIMARY="#1e3b32"
NEXT_PUBLIC_PORTAL_PRIMARY_HOVER="#294e40"
NEXT_PUBLIC_PORTAL_PCO="#2d7e9b"
NEXT_PUBLIC_PORTAL_PCO_HOVER="#236b85"
NEXT_PUBLIC_PORTAL_FONT_FAMILY=Raleway, "Helvetica Neue", sans-serif
NEXT_PUBLIC_PORTAL_LOGO_PATH=/lemc-main-colors.png
# Use `circle` for the subtle line accent or `logo` to display this logo in the upper-right background.
NEXT_PUBLIC_PORTAL_ACCENT_MODE=circle
NEXT_PUBLIC_PORTAL_ACCENT_LOGO_PATH=/lemc-main-colors.png

# A HTTPS Google Fonts stylesheet URL. Use the Google Fonts embed URL, not a font file URL.
NEXT_PUBLIC_PORTAL_GOOGLE_FONT_STYLESHEET=https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap

# Server-only Planning Center OpenID Connect settings. Do not use NEXT_PUBLIC_ here.
PCO_OIDC_CLIENT_ID=
PCO_OIDC_CLIENT_SECRET=
PCO_OIDC_ISSUER=
PCO_OIDC_REDIRECT_URI=http://192.168.0.20/oidc/callback

# Server-only UniFi Network settings. Do not use NEXT_PUBLIC_ here.
# The local UniFi Network console's HTTPS address. Do not include `/proxy/network`.
UNIFI_API_URL=https://192.168.0.1
# Generate an API key in UniFi Network and keep it server-side.
UNIFI_API_KEY=
# Required only when the console uses a self-signed certificate. Use an absolute path to a PEM certificate.
UNIFI_CA_CERT_PATH=
# Local testing only. Allows HTTP or a self-signed HTTPS certificate for UniFi requests only.
UNIFI_ALLOW_INSECURE_CONNECTION=false
# The site's UUID from GET /proxy/network/integration/v1/sites, not the legacy name `default`.
UNIFI_SITE_ID=
# Leave blank to use the site's default guest access duration.
UNIFI_GUEST_ACCESS_MINUTES=